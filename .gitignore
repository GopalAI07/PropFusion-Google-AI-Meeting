# =============================================
# Google AI Assistant - Root .gitignore
# Backend and frontend have their own .gitignore
# for stack-specific rules; this file covers
# things that can appear anywhere in the repo.
# =============================================

# ----- OS files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- Editor / IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Environment variables (never commit real secrets) -----
# .env* covers .env, .env.local, .env.production, .env.development, etc.
# (the old "*.env" pattern here only matched names ENDING in ".env" and
# missed .env.production — that's how a real key got committed)
.env*
!.env.example
!**/.env.example

# ----- Logs -----
*.log
logs/

# ----- Large / generated media -----
# The compressed demo (assets/demo.mp4) IS tracked so it renders in the README.
# Anything else large/raw should be excluded — keep media checked into git small.
*.mov
*.mkv
*.mp4
!assets/demo.mp4

# ----- Misc scratch files -----
*.tmp
*.bak